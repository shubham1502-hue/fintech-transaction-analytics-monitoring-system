# ======================
# Data files
# ======================
# Ignore full datasets
data/raw/transactions_raw.csv
data/processed/transactions_clean.csv

# Ignore legacy root-level generated files
transactions.csv
transactions_clean.csv

# Allow only sample datasets
!data/raw/*_sample.csv
!data/processed/*_sample.csv

